generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id                        String    @id @default(uuid()) @db.VarChar(36)
  username                  String    @unique @db.VarChar(255)
  name                      String    @db.VarChar(255)
  password                  String    @db.VarChar(255)
  role                      String?   @default("user") @db.VarChar(50)
  points                    Int?      @default(0)
  diamonds                  Int?      @default(0)
  games_played              Int?      @default(0)
  games_lost                Int?      @default(0)
  games_won                 Int?      @default(0)
  is_active                 Boolean?  @default(true)
  is_deleted                Boolean?  @default(false)
  created_at                DateTime  @default(now()) @db.DateTime(0)
  updated_at                DateTime  @default(now()) @updatedAt @db.DateTime(0)

  boards                    BoardPlayer[]
  boardsAsCreator           Board[]   @relation("BoardToCreator")

  @@map("users")
}

model Board {
  id            String    @id @default(uuid()) @db.VarChar(36)
  creator       String    @db.VarChar(36)
  creation_mode BoardCreationMode?
  start_time    DateTime? @default(now()) @db.DateTime(0)
  end_time      DateTime? @db.DateTime(0)
  status        BoardStatus?

  is_active     Boolean?  @default(true)
  is_deleted    Boolean?  @default(false)
  created_at    DateTime  @default(now()) @db.DateTime(0)
  updated_at    DateTime  @default(now()) @updatedAt @db.DateTime(0)

  players       BoardPlayer[]
  creatorUser   User      @relation("BoardToCreator", fields: [creator], references: [id])

  @@index([creator], map: "idx_boards_creator")

  @@map("boards")
}


model BoardPlayer {
  id                        String    @id @default(uuid()) @db.VarChar(36)
  board_id                  String    @db.VarChar(36)
  user_id                   String    @db.VarChar(36)
  color                     Color?
  seat_number               Int?      @default(1)
  rank                      Int?
  is_looser                 Boolean   @default(false)

  dice_value                Int?
  rolled_at                 DateTime? @default(now()) @db.DateTime(0)
  
  moves                     Int?      @default(0)
  moves_lost                Int?      @default(0)
  kills                     Int?      @default(0)
  
  board                     Board     @relation(fields: [board_id], references: [id], onDelete: Cascade)
  user                      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  pawns                     Pawn[]
  diceRollLogs              DiceRollLog[]
  moveLogs                  MoveLog[]

  @@unique([board_id, user_id])
  @@index([board_id], map: "idx_board_players_board_id")
  @@index([user_id], map: "idx_board_players_user_id")
  @@map("board_players")
}

model Pawn {
  id                String    @id @default(uuid()) @db.VarChar(36)
  board_player_id   String    @db.VarChar(36)

  cell_type         CellType

  prev_area         Int?
  prev_cell         Int?

  current_area      Int?
  current_cell      Int?

  next_area         Int?
  next_cell         Int?

  is_safe           Boolean?  @default(false)
  has_heart         Boolean?  @default(false)
  moves             Int?      @default(0)
  moves_lost        Int?      @default(0)
  kills             Int?      @default(0)
  last_moved_at     DateTime? @db.Timestamp(0)

  is_active         Boolean?  @default(true)
  is_deleted        Boolean?  @default(false)
  created_at        DateTime  @default(now()) @db.DateTime(0)
  updated_at        DateTime  @default(now()) @updatedAt @db.DateTime(0)

  boardPlayer       BoardPlayer @relation(fields: [board_player_id], references: [id], onDelete: Cascade)

  @@index([board_player_id])
}

model DiceRollLog {
  id               Int       @id @default(autoincrement())
  board_player_id  String    @db.VarChar(36)
  dice_value       Int?
  valid_moves      Json?
  rolled_at        DateTime? @default(now()) @db.DateTime(0)
  is_active        Boolean?  @default(true)
  is_deleted       Boolean?  @default(false)
  created_at       DateTime  @default(now()) @db.DateTime(0)
  updated_at       DateTime  @default(now()) @updatedAt @db.DateTime(0)

  boardPlayer       BoardPlayer @relation(fields: [board_player_id], references: [id], onDelete: Cascade)

  @@index([board_player_id], map: "idx_dice_logs_board_player_id")
  @@map("dice_roll_logs")
}

model MoveLog {
  id                    Int       @id @default(autoincrement())
  board_player_id       String    @db.VarChar(36)
  pawn_id               String?   @db.VarChar(36)
  dice_value            Int?

  // Starting position
  from_area             Int?
  from_cell             Int?

  // Ending position
  to_area               Int?
  to_cell               Int?

  has_captured          Boolean?  @default(false)
  got_captured          Boolean?  @default(false)
  captured_pawn_ids     Json?

  actual_moves          Int?      @default(0)
  prev_move_balance     Int?      @default(0)

  created_at            DateTime? @default(now()) @db.DateTime(0)
  updated_at            DateTime  @default(now()) @updatedAt @db.DateTime(0)

  is_active             Boolean?  @default(true)
  is_deleted            Boolean?  @default(false)

  boardPlayer       BoardPlayer @relation(fields: [board_player_id], references: [id], onDelete: Cascade)

  @@index([board_player_id], map: "idx_move_logs_board_player_id")
  @@map("move_logs")
}
enum BoardCreationMode {
  manual
  system
}

enum BoardStatus {
  active
  waiting
  paused
  finished
  abandoned
}

enum CellType {
  main
  home
  base
  center
}

enum Color {
  red
  blue
  green
  yellow
  orange
  pink
}
